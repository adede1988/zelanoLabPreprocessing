# respiratorySweepAnalysis - own ignore rules (this folder will spin off as its own repo).
# Analysis packs and other MATLAB binaries are large and regenerable from the preprocessed finals.
*.mat
*.asv
*.mex*
pack/

# OS cruft
.DS_Store
Thumbs.db

# Report figures ARE deliverables. The parent zelanoLabPreprocessing/.gitignore ignores *.png / *.jpg
# globally; re-include them here so regenerated report/grant figures stay trackable in this subtree.
!**/*.png
!**/*.jpg
